{
  "uid": "erp-vivo",
  "title": "Monitoreo en vivo · ERP Correo Horizonte",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "demo",
    "ERP"
  ],
  "timezone": "America/Argentina/Buenos_Aires",
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Monitoreo en vivo",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "EN VIVO · Servicio simulado y datos ficticios. p95 > 2 s · Errores > 1 % · Mínimo 20 operaciones por tipo · Ventana acelerada 30 s. No acredita SLO/SLA mensual."
      }
    },
    {
      "id": 2,
      "title": "Disponibilidad actual del ERP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"erp_disponibilidad\"} and on(instance) (up{job=\"erp_disponibilidad\"} == 1)",
          "legendFormat": "{{operacion}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Dato insuficiente o desconocido",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NO DISPONIBLE",
                  "color": "red"
                },
                "1": {
                  "text": "DISPONIBLE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Fuente de métricas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(up{job=\"colector\"} * colector_fuente_disponible) * on() ((time() - colector_ultimo_ciclo_timestamp_segundos) < bool 10)",
          "legendFormat": "{{operacion}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Dato insuficiente o desconocido",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "SIN DATOS FIABLES",
                  "color": "orange"
                },
                "1": {
                  "text": "DISPONIBLE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "Alerta de disponibilidad",
      "type": "alertlist",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "maxItems": 5,
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": true,
          "normal": true,
          "error": true
        },
        "alertName": "Indisponibilidad"
      }
    },
    {
      "id": 5,
      "title": "Latencia p95 por operación · mínimo 20",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "erp_latencia_p95_ventana_segundos{fase=\"en_vivo\"} and on(operacion) (sum by (operacion) (erp_operaciones_ventana{fase=\"en_vivo\"}) >= 20) and on() (up{job=\"colector\"} == 1) and on() (colector_fuente_disponible == 1) and on() ((time() - colector_ultimo_ciclo_timestamp_segundos) < 10)",
          "legendFormat": "{{operacion}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Dato insuficiente o desconocido",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
